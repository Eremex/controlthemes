<ResourceDictionary xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Design.PreviewWith>
        <Border Padding="20">
            <StackPanel Spacing="20">
                <Button Content="Click Me!" />
                <Button Classes="accent" Content="Click Me!" IsEnabled="True" />
                <Button Classes="warning" Content="Click Me!" />
                <Button Classes="warning accent" Content="Click Me!" />
                <Button Content="Click Me!" IsEnabled="False" />
                <Border Background="{DynamicResource Fill/Neutral/Secondary/Enabled}" Padding="10">
                    <StackPanel Spacing="20">
                        <Button Content="Click Me!" Classes="secondary" />
                        <Button Content="Click Me!" Classes="secondary" IsEnabled="False" />
                        <Button Content="Click Me!" Classes="warning secondary" />
                        <Button Content="Click Me!" Classes="warning secondary" IsEnabled="False" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <Thickness x:Key="AccentButtonBackgroundFocusedMargin">2</Thickness>

    <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Fill/Neutral/Secondary/Enabled}" />
        <Setter Property="Foreground" Value="{DynamicResource Text/Accent/Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Outline/Neutral/Transparent/Light}" />
        <Setter Property="BorderThickness" Value="{StaticResource EditorBorderThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource EditorCornerRadius}" />
        <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border x:Name="PART_BackgroundBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          CornerRadius="{TemplateBinding CornerRadius}"
                                          RecognizesAccessKey="True"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <Border Name="PART_ButtonBorder"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Background="{x:Null}"/>
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource Text/Accent/Primary}" />
        </Style>

        <!-- PointerOver, Focused State -->
        <Style Selector="^:pointerover, ^:focus">
            <Style Selector="^ /template/ Border#PART_BackgroundBorder">
                <Setter Property="Background" Value="{DynamicResource Fill/Neutral/Secondary/Hover}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Foreground" Value="{DynamicResource Text/Accent/Primary}" />
            </Style>
            <Style Selector="^ /template/ Border#PART_ButtonBorder">
                <Setter Property="BorderBrush" Value="{DynamicResource Outline/Neutral/Transparent/Light}" />
            </Style>
        </Style>

        <!-- Pressed State -->
        <Style Selector="^:pressed">
            <Style Selector="^ /template/ Border#PART_BackgroundBorder">
                <Setter Property="Background" Value="{DynamicResource Fill/Neutral/Secondary/Pressed}" />
            </Style>
            <Style Selector="^  /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Foreground" Value="{DynamicResource Text/Accent/Primary}" />
                <Setter Property="Opacity" Value="0.8"/>
            </Style>
        </Style>

        <!-- Disabled State -->
        <Style Selector="^:disabled">
            <Style Selector="^ /template/ Border#PART_BackgroundBorder">
                <Setter Property="Background" Value="{DynamicResource Fill/Neutral/Secondary/Disabled}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Foreground" Value="{DynamicResource Text/Neutral/Disabled}" />
            </Style>
            <Style Selector="^ /template/ Border#PART_ButtonBorder">
                <Setter Property="BorderBrush" Value="{DynamicResource TransparentBrush}" />
            </Style>
        </Style>
        <!-- Accent style -->
        <Style Selector="^.accent">
            <Style Selector="^ /template/ Border#PART_BackgroundBorder">
                <Setter Property="Background" Value="{DynamicResource Fill/Accent/Primary/Enabled}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Foreground" Value="{DynamicResource Text/On Accent/Primary}" />
            </Style>
            <Style Selector="^ /template/ Border#PART_ButtonBorder">
                <Setter Property="BorderBrush" Value="{DynamicResource TransparentBrush}" />
            </Style>
            <Style Selector="^:focus">
                <Setter Property="Padding" Value="{DynamicResource AccentButtonFocusedPadding}"/>
            </Style>
            <Style Selector="^:focus /template/ Border#PART_BackgroundBorder">
                <Setter Property="Margin" Value="{StaticResource AccentButtonBackgroundFocusedMargin}" />
            </Style>

            <!-- Accent PointerOver, Focused State -->
            <Style Selector="^:pointerover, ^:focus">
                <Style Selector="^ /template/ Border#PART_BackgroundBorder">
                    <Setter Property="Background" Value="{DynamicResource Fill/Accent/Primary/Hover}" />
                </Style>
                <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Foreground" Value="{DynamicResource Text/On Accent/Primary}" />
                </Style>
            </Style>

            <!-- Accent PressedState -->
            <Style Selector="^:pressed">
                <Style Selector="^ /template/ Border#PART_BackgroundBorder">
                    <Setter Property="Background" Value="{DynamicResource Fill/Accent/Primary/Pressed}" />
                </Style>
                <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Foreground" Value="{DynamicResource Text/On Accent/Primary}" />
                </Style>
            </Style>

            <!-- Accent DisabledState -->
            <Style Selector="^:disabled">
                <Style Selector="^ /template/ Border#PART_BackgroundBorder">
                    <Setter Property="Background" Value="{DynamicResource Fill/Accent/Primary/Disabled}" />
                </Style>
                <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Foreground" Value="{DynamicResource Text/Neutral/Disabled}" />
                </Style>
            </Style>
        </Style>

        <!-- Warning style -->
        <Style Selector="^.warning">
            <Style Selector="^ /template/ Border#PART_BackgroundBorder">
                <Setter Property="Background" Value="{DynamicResource Fill/Neutral/Secondary/Enabled}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Foreground" Value="{DynamicResource Text/Accent/Error}" />
            </Style>
            <Style Selector="^ /template/ Border#PART_ButtonBorder">
                <Setter Property="BorderBrush" Value="{DynamicResource Outline/Neutral/Transparent/Light}" />
            </Style>

            <!-- Warning PointerOver, Focused State -->
            <Style Selector="^:pointerover, ^:focus">
                <Style Selector="^ /template/ Border#PART_BackgroundBorder">
                    <Setter Property="Background" Value="{DynamicResource Fill/Neutral/Secondary/Hover}" />
                </Style>
                <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Foreground" Value="{DynamicResource Text/Accent/Error}" />
                </Style>
            </Style>

            <!-- Warning PressedState -->
            <Style Selector="^:pressed">
                <Style Selector="^ /template/ Border#PART_BackgroundBorder">
                    <Setter Property="Background" Value="{DynamicResource Fill/Neutral/Secondary/Pressed}" />
                </Style>
                <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Foreground" Value="{DynamicResource Text/Accent/Error}" />
                </Style>
            </Style>

            <!-- Warning DisabledState -->
            <Style Selector="^:disabled">
                <Style Selector="^ /template/ Border#PART_BackgroundBorder">
                    <Setter Property="Background" Value="{DynamicResource Fill/Neutral/Secondary/Disabled}" />
                </Style>
                <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Foreground" Value="{DynamicResource Text/Neutral/Disabled}" />
                </Style>
                <Style Selector="^ /template/ Border#PART_ButtonBorder">
                    <Setter Property="BorderBrush" Value="{DynamicResource TransparentBrush}" />
                </Style>
            </Style>
        </Style>

        <!-- WarningAccent style -->
        <Style Selector="^.warning.accent">
            <Style Selector="^ /template/ Border#PART_BackgroundBorder">
                <Setter Property="Background" Value="{DynamicResource Fill/Accent/Error/Enabled}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Foreground" Value="{DynamicResource Text/On Accent/Primary}" />
            </Style>
            <Style Selector="^ /template/ Border#PART_ButtonBorder">
                <Setter Property="BorderBrush" Value="{DynamicResource TransparentBrush}" />
            </Style>

            <!-- WarningAccent PointerOver, Focused State -->
            <Style Selector="^:pointerover, ^:focus">
                <Style Selector="^ /template/ Border#PART_BackgroundBorder">
                    <Setter Property="Background" Value="{DynamicResource Fill/Accent/Error/Hover}" />
                </Style>
                <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Foreground" Value="{DynamicResource Text/On Accent/Primary}" />
                </Style>
            </Style>

            <!-- WarningAccent PressedState -->
            <Style Selector="^:pressed">
                <Style Selector="^ /template/ Border#PART_BackgroundBorder">
                    <Setter Property="Background" Value="{DynamicResource Fill/Accent/Error/Pressed}" />
                </Style>
                <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Foreground" Value="{DynamicResource Text/On Accent/Primary}" />
                </Style>
            </Style>

            <!-- WarningAccent DisabledState -->
            <Style Selector="^:disabled">
                <Style Selector="^ /template/ Border#PART_BackgroundBorder">
                    <Setter Property="Background" Value="{DynamicResource Fill/Accent/Primary/Disabled}" />
                </Style>
                <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Foreground" Value="{DynamicResource Text/Neutral/Disabled}" />
                </Style>
            </Style>
        </Style>

        <!--Secondary style-->
        <Style Selector="^.secondary">
            <Style Selector="^ /template/ Border#PART_BackgroundBorder">
                <Setter Property="Background" Value="{DynamicResource Fill/Neutral/Primary/Enabled}" />
            </Style>

            <!--Secondary PointerOver, KeyboardFocused state-->
            <Style Selector="^:pointerover /template/ Border#PART_BackgroundBorder,
                   ^:focus /template/ Border#PART_BackgroundBorder">
                <Setter Property="Background" Value="{DynamicResource Fill/Neutral/Primary/Hover}" />
            </Style>

            <!--Secondary Pressed state-->
            <Style Selector="^:pressed /template/ Border#PART_BackgroundBorder">
                <Setter Property="Background" Value="{DynamicResource Fill/Neutral/Primary/Pressed}" />
            </Style>

            <!--Secondary Disabled state-->
            <Style Selector="^:disabled /template/ Border#PART_BackgroundBorder">
                <Setter Property="Background" Value="{DynamicResource Fill/Neutral/Primary/Disabled}" />
            </Style>
        </Style>

        <!--Focus Border-->
        <Style Selector="^:focus /template/ Border#PART_ButtonBorder">
            <Setter Property="BorderBrush" Value="{DynamicResource Outline/Accent/Focus}" />
            <Setter Property="BorderThickness" Value="{StaticResource EditorBorderThickness}"/>
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type RepeatButton}" TargetType="RepeatButton" BasedOn="{StaticResource {x:Type Button}}"/>

</ResourceDictionary>