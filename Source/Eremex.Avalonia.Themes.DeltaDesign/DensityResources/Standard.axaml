<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    
    <Thickness x:Key="ButtonPadding">12,6,12,7</Thickness>
    <Thickness x:Key="AccentButtonFocusedPadding">10,4,10,5</Thickness>

    <x:Double x:Key="SliderHorizontalHeight">24</x:Double>
    <x:Double x:Key="SliderVerticalWidth">24</x:Double>
    <GridLength x:Key="SliderPreContentNoTickMargin">1</GridLength>
    <GridLength x:Key="SliderPostContentNoTickMargin">1</GridLength>

    <x:Double x:Key="ListBoxItemMinHeight">28</x:Double>
    <CornerRadius x:Key="ListBoxItemCornerRadius">6</CornerRadius>

    <x:Double x:Key="MxSplitButtonToggleFocusedMinWidth">26</x:Double>
    <Thickness x:Key="MxSplitButtonAccentButtonFocusedPadding">10,4,12,5</Thickness>

    <x:Double x:Key="DayButtonMinHeight">29</x:Double>
    
    <x:Double x:Key="EditorMinHeight">28</x:Double>
    <x:Double x:Key="ControlMinHeight">24</x:Double>
    <x:Double x:Key="ButtonMinWidth">28</x:Double>
    <Thickness x:Key="EditorIconButtonPadding">6,3</Thickness>

    <x:Double x:Key="ColorPickerControlWidth">312</x:Double>
    <GridLength x:Key="ColorPickerSliderTopMargin">8</GridLength>
    <x:Double x:Key="ColorPickerTransparencySliderTopMargin">6</x:Double>
    <GridLength x:Key="ColorPickerSliderBottomMargin">0</GridLength>
    <GridLength x:Key="ColorPickerColorComponentTopMargin">14</GridLength>
    <Thickness x:Key="ColorPickerControlPadding">8,8,8,6</Thickness>

    <x:Double x:Key="ColorEditorWidth">312</x:Double>
    <x:Double x:Key="ColorButtonDefaultSize">21</x:Double>
    <Thickness x:Key="ColorEditorSelectorsMargin">6,0,0,6</Thickness>
    <Thickness x:Key="ColorEditorThemeSelectorMargin">0,6,0,0</Thickness>
    <Thickness x:Key="ColorEditorDescriptionMargin">8,0,18,6</Thickness>
    <Thickness x:Key="ColorEditorPlatformSelectorMargin">8,4,8,4</Thickness>

    <x:Double x:Key="PopupColorEditorPopupWidth">314</x:Double>

    <x:Double x:Key="DataControlHeaderPanelMinHeight">28</x:Double>
    <x:Double x:Key="DataControlRowMinHeight">29</x:Double>
    <Thickness x:Key="DataControlColumnHeaderPadding">6</Thickness>
    <Thickness x:Key="DataControlColumnHeaderFilterButtonPadding">6</Thickness>
    <Thickness x:Key="DataControlFooterPadding">0,6,6,6</Thickness>
    <Thickness x:Key="DataControlFooterButtonPadding">6</Thickness>
    <Thickness x:Key="DataControlFooterEditorTitlePadding">0,8</Thickness>
    <Thickness x:Key="DataControlFooterEditorPadding">0,8,0,0</Thickness>
    <Thickness x:Key="DataControlFooterEditorButtonPadding">16,8</Thickness>

    <Thickness x:Key="DataGridGroupPanelPadding">0,10</Thickness>

    <Thickness x:Key="GroupPadding">8</Thickness>
    <Thickness x:Key="GroupPaddingTop">0,8,0,0</Thickness>

    <Thickness x:Key="ControlMargin">2</Thickness>
    <Thickness x:Key="ControlMarginTopBottom">0,2</Thickness>

    <x:Double x:Key="MxTabItemMinHeight">28</x:Double>
    <x:Double x:Key="MxTabItemSelectedMinHeight">29</x:Double>

    <Thickness x:Key="DialogWindowContentPadding">20</Thickness>
    <Thickness x:Key="DialogWindowButtonsPadding">20,0,20,20</Thickness>
    <Thickness x:Key="DialogWindowFooterPadding">16,8</Thickness>

    <Thickness x:Key="MxWindowCaptionButtonPadding">8</Thickness>
    <Thickness x:Key="MxWindowCaptionButtonMargin">4,0,4,0</Thickness>
    <Thickness x:Key="MxWindowCaptionButtonLeftMargin">4,0,0,0</Thickness>
    <CornerRadius x:Key="MxWindowCaptionButtonCornerRadius">6</CornerRadius>
    <x:Double x:Key="MxWindowCaptionButtonMinWidth">28</x:Double>
    <x:Double x:Key="MxWindowCaptionButtonMinHeight">28</x:Double>
    <Thickness x:Key="MxWindowIconMargin">8,8,0,8</Thickness>
    <Thickness x:Key="MxWindowIconMarginMaximized">4,4,0,4</Thickness>
    <Thickness x:Key="MxWindowHeaderMargin">8</Thickness>
    <Thickness x:Key="MxWindowHeaderMarginMaximized">4</Thickness>
    <x:Double x:Key="MxWindowHeaderMinHeight">16</x:Double>
    <x:Double x:Key="MxWindowFontSize">12</x:Double>
    <x:Double x:Key="MxWindowHeaderLineHeight">16</x:Double>

</ResourceDictionary>
