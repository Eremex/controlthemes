<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    
    <Thickness x:Key="ButtonPadding">12,9,12,10</Thickness>
    <Thickness x:Key="AccentButtonFocusedPadding">10,7,10,8</Thickness>

    <x:Double x:Key="SliderHorizontalHeight">30</x:Double>
    <x:Double x:Key="SliderVerticalWidth">30</x:Double>   
    <GridLength x:Key="SliderPreContentNoTickMargin">4</GridLength>
    <GridLength x:Key="SliderPostContentNoTickMargin">4</GridLength>    

    <x:Double x:Key="ListBoxItemMinHeight">34</x:Double>
    <CornerRadius x:Key="ListBoxItemCornerRadius">6</CornerRadius>

    <x:Double x:Key="MxSplitButtonToggleFocusedMinWidth">32</x:Double>
    <Thickness x:Key="MxSplitButtonAccentButtonFocusedPadding">10,7,12,8</Thickness>
  
    <x:Double x:Key="DayButtonMinHeight">33</x:Double>
        
    <x:Double x:Key="EditorMinHeight">34</x:Double>
    <x:Double x:Key="ControlMinHeight">30</x:Double>
    <x:Double x:Key="ButtonMinWidth">34</x:Double>
    <Thickness x:Key="EditorIconButtonPadding">6,3</Thickness>

    <x:Double x:Key="ColorPickerControlWidth">390</x:Double>
    <GridLength x:Key="ColorPickerSliderTopMargin">8</GridLength>
    <x:Double x:Key="ColorPickerTransparencySliderTopMargin">2</x:Double>
    <GridLength x:Key="ColorPickerSliderBottomMargin">4</GridLength>
    <GridLength x:Key="ColorPickerColorComponentTopMargin">16</GridLength>
    <Thickness x:Key="ColorPickerControlPadding">12,12,12,4</Thickness>

    <x:Double x:Key="ColorEditorWidth">392</x:Double>
    <x:Double x:Key="ColorButtonDefaultSize">27</x:Double>
    <Thickness x:Key="ColorEditorSelectorsMargin">10,0,0,10</Thickness>
    <Thickness x:Key="ColorEditorThemeSelectorMargin">0,10,0,0</Thickness>
    <Thickness x:Key="ColorEditorDescriptionMargin">12,0,18,10</Thickness>
    <Thickness x:Key="ColorEditorPlatformSelectorMargin">12,8,12,8</Thickness>
    
    <x:Double x:Key="PopupColorEditorPopupWidth">392</x:Double>

    <x:Double x:Key="DataControlHeaderPanelMinHeight">34</x:Double>
    <x:Double x:Key="DataControlRowMinHeight">35</x:Double>
    <Thickness x:Key="DataControlColumnHeaderPadding">6,9</Thickness>
    <Thickness x:Key="DataControlColumnHeaderFilterButtonPadding">6</Thickness>
    <Thickness x:Key="DataControlFooterPadding">0,9,6,9</Thickness>
    <Thickness x:Key="DataControlFooterButtonPadding">6</Thickness>
    <Thickness x:Key="DataControlFooterEditorTitlePadding">0,12</Thickness>
    <Thickness x:Key="DataControlFooterEditorPadding">0,12,0,0</Thickness>
    <Thickness x:Key="DataControlFooterEditorButtonPadding">16,12</Thickness>

    <Thickness x:Key="DataGridGroupPanelPadding">0,13,0,14</Thickness>

    <Thickness x:Key="GroupPadding">12</Thickness>
    <Thickness x:Key="GroupPaddingTop">0,12,0,0</Thickness>

    <Thickness x:Key="ControlMargin">3</Thickness>
    <Thickness x:Key="ControlMarginTopBottom">0,3</Thickness>

    <x:Double x:Key="MxTabItemMinHeight">34</x:Double>
    <x:Double x:Key="MxTabItemSelectedMinHeight">35</x:Double>

    <Thickness x:Key="DialogWindowContentPadding">28</Thickness>
    <Thickness x:Key="DialogWindowButtonsPadding">28,0,28,28</Thickness>
    <Thickness x:Key="DialogWindowFooterPadding">20,12</Thickness>

    <Thickness x:Key="MxWindowCaptionButtonPadding">10</Thickness>
    <Thickness x:Key="MxWindowCaptionButtonMargin">6,0,6,0</Thickness>
    <Thickness x:Key="MxWindowCaptionButtonLeftMargin">6,0,0,0</Thickness>
    <CornerRadius x:Key="MxWindowCaptionButtonCornerRadius">8</CornerRadius>
    <x:Double x:Key="MxWindowCaptionButtonMinWidth">32</x:Double>
    <x:Double x:Key="MxWindowCaptionButtonMinHeight">32</x:Double>
    <Thickness x:Key="MxWindowIconMargin">10,10,0,10</Thickness>
    <Thickness x:Key="MxWindowIconMarginMaximized">6,6,0,6</Thickness>
    <Thickness x:Key="MxWindowHeaderMargin">10</Thickness>
    <Thickness x:Key="MxWindowHeaderMarginMaximized">6</Thickness>
    <x:Double x:Key="MxWindowHeaderMinHeight">18</x:Double>
    <x:Double x:Key="MxWindowFontSize">14</x:Double>
    <x:Double x:Key="MxWindowHeaderLineHeight">18</x:Double>

</ResourceDictionary>
