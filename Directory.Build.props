<Project>
  <PropertyGroup>
    <EMXControlsVersion>1.5.53-preview3</EMXControlsVersion>
    <Company>Eremex</Company>
    <Copyright>©2010-2026 Eremex</Copyright>
    <Product>Eremex Controls</Product>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
    <GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>

    <NugetAuthors>Eremex.Avalonia.Controls</NugetAuthors>
    <NugetCopyright>©2010-2026 Eremex</NugetCopyright>
    <NugetProjectUrl>https://eremexcontrols.net/</NugetProjectUrl>
  </PropertyGroup>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <LangVersion>12.0</LangVersion>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <AvaloniaVersion>12.1.0</AvaloniaVersion>
    <AvaloniaSvgSkiaVersion>12.0.0.11</AvaloniaSvgSkiaVersion>
    <SkiaSharpVersion>3.119.4</SkiaSharpVersion>
    <MicrosoftCodeAnalysisVersion>4.3.0</MicrosoftCodeAnalysisVersion>
    <Version>$(EMXControlsVersion)</Version>
    <NuspecProperties>$(NuspecProperties);version=$(Version)</NuspecProperties>
    <NuspecProperties>$(NuspecProperties);configuration=$(Configuration)</NuspecProperties>
    <NuspecProperties>$(NuspecProperties);avaloniaversion=$(AvaloniaVersion)</NuspecProperties>
    <NuspecProperties>$(NuspecProperties);avaloniasvgskiaversion=$(AvaloniaSvgSkiaVersion)</NuspecProperties>
    <NuspecProperties>$(NuspecProperties);skiasharpversion=$(SkiaSharpVersion)</NuspecProperties>
    <NuspecProperties>$(NuspecProperties);nugetauthors=$(NugetAuthors)</NuspecProperties>
    <NuspecProperties>$(NuspecProperties);nugetcopyright=$(NugetCopyright)</NuspecProperties>
    <NuspecProperties>$(NuspecProperties);nugetprojecturl=$(NugetProjectUrl)</NuspecProperties>
  </PropertyGroup>

  <PropertyGroup>
    <NoWarn>NU1803;</NoWarn>
  </PropertyGroup>
</Project>
